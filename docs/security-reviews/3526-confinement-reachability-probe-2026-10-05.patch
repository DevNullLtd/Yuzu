+yuzu::test::PgTestTemplate confprobe_tpl{"confprobe_all", [](const std::string& dsn) {
+    PgPool pool{{.conninfo = dsn, .size = 1}};
+    RbacStore rbac{pool};
+    if (!rbac.is_open())
+        throw std::runtime_error("confprobe tpl: rbac");
+    TagStore tags{pool};
+    if (!tags.is_open())
+        throw std::runtime_error("confprobe tpl: tags");
+    ExecutionTracker et{pool};
+    if (!et.is_open())
+        throw std::runtime_error("confprobe tpl: exec tracker");
+    ResponseStore rs{pool, 0};
+    if (!rs.is_open())
+        throw std::runtime_error("confprobe tpl: response store");
+    InstructionStore is{pool};
+    if (!is.is_open())
+        throw std::runtime_error("confprobe tpl: instruction store");
+    AuditStore as{pool};
+    if (!as.is_open())
+        throw std::runtime_error("confprobe tpl: audit store");
+}};
