+Resp call_legacy_resp(Rig& r, const std::string& path, const std::string& token) {
+    yuzu::server::test::TestRouteSink sink;
+    response::Deps d;
+    d.fleet_read_fn = r.fleet_read_fn();
+    d.audit_fn = r.audit_fn();
+    d.store = &r.responses;
+    response::register_response_routes(sink, std::move(d));
+    auto res =
+        sink.dispatch("GET", path, {}, "application/json", {{"Authorization", "Bearer " + token}});
+    REQUIRE(res);
+    return {res->status, res->body};
+}
