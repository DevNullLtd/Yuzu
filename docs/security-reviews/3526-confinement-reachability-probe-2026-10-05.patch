+bool has(const std::string& hay, const std::string& needle) {
+    return hay.find(needle) != std::string::npos;
+}
+
+struct Principal {
+    std::string name, token;
+};
+
+void probe_principal(Rig& r, const std::string& mode, const Principal& p) {
+    httplib::Request req;
+    req.set_header("Authorization", "Bearer " + p.token);
+    httplib::Response res_plain;
+    const bool plain = r.ar->require_permission(req, res_plain, "Execution", "Read");
+    httplib::Response res_fleet;
+    auto fgate = r.fleet_read_fn()(req, res_fleet, "Execution", "Read");
+
+    auto frag = call_fragment(r, p.token);
+    auto mcp_x2 = call_mcp_summarize(r, p.token, r.x2);
+    auto mcp_missing = call_mcp_summarize(r, p.token, "no-such-exec");
+    V1 v1{r};
+    auto v1list = v1.get("/api/v1/executions", p.token);
+
+    auto leaks = [](const Resp& x) {
+        return has(x.body, "SECRET-OUT") || has(x.body, "def-OUTONLY") || has(x.body, "carol") ||
+               has(x.body, "targeted=1");
+    };
+    out_line("[" + mode + "] principal=" + p.name + " plain(Execution:Read)=" +
+             (plain ? "ADMIT" : "DENY(" + std::to_string(res_plain.status) + ")") +
+             " fleet_read=" + describe_scope(fgate) + "(" + std::to_string(res_fleet.status) + ")");
+    out_line("    (1) fragment: status=" + std::to_string(frag.status) +
+             " out_of_scope_data=" + (leaks(frag) ? "YES" : "no") +
+             " rows_def-OUTONLY=" + (has(frag.body, "def-OUTONLY") ? "yes" : "no") +
+             " SECRET-OUT-ERR=" + (has(frag.body, "SECRET-OUT-ERR") ? "yes" : "no"));
+    out_line("    (2) mcp summarize(X2 out-of-scope-only): status=" + std::to_string(mcp_x2.status) +
+             " reveals_exec=" + (has(mcp_x2.body, "is failure") || has(mcp_x2.body, "targeted=") ? "YES" : "no") +
+             " vs not-found=" + (has(mcp_missing.body, "was not found") ? "oracle-distinguishable" : "n/a") +
+             " | body=" + mcp_x2.body.substr(0, 220));
+    out_line("    (v1 twin) GET /api/v1/executions: status=" + std::to_string(v1list.status) +
+             " includes_def-OUTONLY=" + (has(v1list.body, "def-OUTONLY") ? "yes" : "no") +
+             " SECRET-OUT-ERR=" + (has(v1list.body, "SECRET-OUT-ERR") ? "yes" : "no"));
+}
