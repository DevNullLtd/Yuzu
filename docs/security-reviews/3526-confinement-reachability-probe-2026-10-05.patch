+// --- surface callers ------------------------------------------------------
+
+Resp call_fragment(Rig& r, const std::string& token) {
+    yuzu::server::test::TestRouteSink sink;
+    WorkflowRoutes routes;
+    WorkflowRoutes::Deps d;
+    d.auth_fn = r.auth_fn();
+    d.perm_fn = r.perm_fn();
+    d.fleet_read_fn = r.fleet_read_fn();
+    d.audit_fn = [](const httplib::Request&, const std::string&, const std::string&,
+                    const std::string&, const std::string&, const std::string&) {};
+    d.execution_tracker = &r.tracker;
+    routes.register_routes(sink, std::move(d));
+    auto res = sink.dispatch("GET", "/fragments/executions", {}, "application/json",
+                             {{"Authorization", "Bearer " + token}});
+    REQUIRE(res);
+    return {res->status, res->body};
+}
+
+Resp call_mcp_summarize(Rig& r, const std::string& token, const std::string& exec_id) {
+    yuzu::server::mcp::McpServer mcp;
+    bool read_only = false, mcp_disabled = false;
+    auto handler = mcp.build_handler(
+        r.auth_fn(), r.perm_fn(),
+        [&r](const httplib::Request& q, const std::string& a, const std::string& re,
+             const std::string& tt, const std::string& ti, const std::string& d) -> bool {
+            return r.audit_fn()(q, a, re, tt, ti, d);
+        },
+        []() -> nlohmann::json { return nlohmann::json::array(); }, &r.rbac,
+        /*instruction_store=*/nullptr, &r.tracker, &r.responses,
+        /*audit_store=*/nullptr, /*tag_store=*/&r.tags, /*inventory_store=*/nullptr,
+        /*policy_store=*/nullptr, &r.mgmt, /*approval_manager=*/nullptr,
+        /*schedule_engine=*/nullptr, read_only, mcp_disabled);
+    httplib::Request req;
+    req.method = "POST";
+    req.path = "/mcp/v1/";
+    req.body = std::string(R"({"jsonrpc":"2.0","method":"tools/call","id":1,"params":{"name":"summarize_working_set","arguments":{"kind":"execution","id":")") +
+               exec_id + R"("}}})";
+    req.set_header("Content-Type", "application/json");
+    req.set_header("Authorization", "Bearer " + token);
+    httplib::Response res;
+    res.status = 200;
+    handler(req, res);
+    return {res.status, res.body};
+}
