+TEST_CASE("confprobe: RBAC ON matrix (fragment / MCP / v1 twin)", "[pg][confprobe]") {
+    YUZU_REQUIRE_PG_DB_TPL(db, confprobe_tpl);
+    Rig r{db.dsn()};
+    out_line("=== RBAC ON ===");
+
+    std::vector<Principal> ps{
+        {"P_global(gary)", r.mint("gary")},
+        {"P_scoped(bob)", r.mint("bob")},
+        {"P_service(bob,svc=printers)", r.mint("bob", "printers")},
+        {"P_service(gary,svc=printers)", r.mint("gary", "printers")},
+        {"P_mcp_readonly(bob)", r.mint("bob", {}, "readonly")},
+        {"P_mcp_operator(bob)", r.mint("bob", {}, "operator")},
+        {"P_mcp_supervised(bob)", r.mint("bob", {}, "supervised")},
+        {"P_mcp_readonly(gary)", r.mint("gary", {}, "readonly")},
+        {"P_mcp_svc(bob,readonly,svc)", r.mint("bob", "printers", "readonly")},
+    };
+    for (auto& p : ps)
+        probe_principal(r, "RBAC-ON", p);
+
+    // ---- assertions (the headline claims) ----
+    auto frag_bob = call_fragment(r, ps[1].token);
+    CHECK(frag_bob.status == 403); // scoped-only principal DENIED by plain gate
+    auto frag_gary = call_fragment(r, ps[0].token);
+    CHECK(frag_gary.status == 200);
+    CHECK(has(frag_gary.body, "def-OUTONLY"));
+    auto frag_svc = call_fragment(r, ps[2].token);
+    CHECK(frag_svc.status == 403);
+    auto mcp_bob = call_mcp_summarize(r, ps[4].token, r.x2);
+    CHECK(mcp_bob.status == 403);
+    CHECK_FALSE(has(mcp_bob.body, "targeted="));
+}
