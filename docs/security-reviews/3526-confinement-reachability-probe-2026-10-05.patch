+struct Rig {
+    Config cfg{};
+    auth::AuthManager auth_mgr{};
+    PgPool pool;
+    RbacStore rbac;
+    yuzu::test::ManagementGroupStorePg mgmt_bundle;
+    ManagementGroupStore& mgmt = *mgmt_bundle;
+    yuzu::test::ApiTokenStorePg api_tokens;
+    TagStore tags;
+    PgPool audit_pool;
+    AuditStore audit_store;
+    std::shared_mutex oidc_mu;
+    std::unique_ptr<oidc::OidcProvider> oidc_provider;
+    std::unique_ptr<AuthRoutes> ar;
+    ExecutionTracker tracker;
+    ResponseStore responses;
+
+    std::string gG, gO; // G = the confined group (a_in); O = other group (a_out)
+    std::string x1, x2; // execution ids
+    std::vector<AuditRow> audits;
+    bool audit_ok{true};
+
+    explicit Rig(const std::string& dsn)
+        : pool{{.conninfo = dsn, .size = 6}}, rbac{pool}, tags{pool},
+          audit_pool{{.conninfo = dsn, .size = 2}}, audit_store{audit_pool}, tracker{pool},
+          responses{pool, 0} {
+        REQUIRE(rbac.is_open());
+        REQUIRE(tracker.is_open());
+        REQUIRE(responses.is_open());
+        rbac.set_rbac_enabled(true);
+
+        for (auto [role, type] : std::vector<std::pair<std::string, std::string>>{
+                 {"ExecReadG", "Execution"}, {"RespReadG", "Response"}, {"InfraReadG", "Infrastructure"}}) {
+            REQUIRE(rbac.create_role({role, "", false, 0}).has_value());
+            REQUIRE(rbac.set_permission({role, type, "Read", "allow"}).has_value());
+        }
+        // gary: GLOBAL Execution:Read + Response:Read + Infrastructure:Read.
+        for (auto role : {"ExecReadG", "RespReadG", "InfraReadG"})
+            REQUIRE(rbac.assign_role({"user", "gary", role}).has_value());
+        // bob: ONLY Infrastructure:Read globally (MCP generic gate); Execution:Read and
+        // Response:Read ONLY through management group G.
+        REQUIRE(rbac.assign_role({"user", "bob", "InfraReadG"}).has_value());
+
+        gG = mk_group("G");
+        gO = mk_group("O");
+        REQUIRE(mgmt.add_member(gG, "a_in").has_value());
+        REQUIRE(mgmt.add_member(gO, "a_out").has_value());
+        REQUIRE(mgmt.assign_role({gG, "user", "bob", "ExecReadG"}).has_value());
+        REQUIRE(mgmt.assign_role({gG, "user", "bob", "RespReadG"}).has_value());
+
+        REQUIRE(tags.set_tag("a_in", "service", "printers").has_value());
+
+        REQUIRE(auth_mgr.upsert_user("gary", "correct-horse-battery-staple", auth::Role::user));
+        REQUIRE(auth_mgr.upsert_user("bob", "correct-horse-battery-staple", auth::Role::user));
+
+        ar = std::make_unique<AuthRoutes>(cfg, auth_mgr, &rbac, api_tokens.get(), &audit_store,
+                                          &mgmt, &tags, nullptr, oidc_mu, oidc_provider);
+        seed();
+    }
+
+    std::string mk_group(const std::string& name) {
+        ManagementGroup g;
+        g.name = name;
+        g.membership_type = "static";
+        auto id = mgmt.create_group(g);
+        REQUIRE(id.has_value());
+        return *id;
+    }
+
+    void seed() {
+        // X1: fans out to a_in (success) AND a_out (failure, secret error)
+        {
+            Execution e;
+            e.definition_id = "def-MIXED";
+            e.dispatched_by = "carol";
+            e.status = "completed";
+            e.dispatched_at = 1735689600;
+            e.agents_targeted = 2;
+            auto id = tracker.create_execution(e);
+            REQUIRE(id.has_value());
+            x1 = *id;
+            AgentExecStatus a;
+            a.agent_id = "a_in";
+            a.status = "success";
+            a.completed_at = 1735689610;
+            tracker.update_agent_status(x1, a);
+            AgentExecStatus b;
+            b.agent_id = "a_out";
+            b.status = "failure";
+            b.completed_at = 1735689620;
+            b.error_detail = "SECRET-OUT-ERR-X1";
+            tracker.update_agent_status(x1, b);
+        }
+        // X2: ONLY a_out (completely outside G)
+        {
+            Execution e;
+            e.definition_id = "def-OUTONLY";
+            e.dispatched_by = "carol";
+            e.status = "completed";
+            e.dispatched_at = 1735689601;
+            e.agents_targeted = 1;
+            auto id = tracker.create_execution(e);
+            REQUIRE(id.has_value());
+            x2 = *id;
+            AgentExecStatus b;
+            b.agent_id = "a_out";
+            b.status = "failure";
+            b.completed_at = 1735689630;
+            b.error_detail = "SECRET-OUT-ERR-X2";
+            tracker.update_agent_status(x2, b);
+        }
+        // legacy responses (instruction_id "cmd-1")
+        StoredResponse r1;
+        r1.instruction_id = "cmd-1";
+        r1.agent_id = "a_in";
+        r1.timestamp = 1735689610;
+        r1.output = "IN-OUTPUT";
+        r1.status = 0;
+        responses.store(r1);
+        StoredResponse r2 = r1;
+        r2.agent_id = "a_out";
+        r2.output = "SECRET-OUT-OUTPUT";
+        responses.store(r2);
+    }
+
+    std::string mint(const std::string& user, const std::string& scope_service = {},
+                     const std::string& tier = {}) {
+        auto raw = api_tokens->create_token("probe", user, now_epoch() + 3600, scope_service, tier);
+        REQUIRE(raw.has_value());
+        return *raw;
+    }
+
+    // adapters wired exactly as server.cpp does
+    auto auth_fn() {
+        return [this](const httplib::Request& req,
+                      httplib::Response& res) -> std::optional<auth::Session> {
+            return ar->require_auth(req, res);
+        };
+    }
+    auto perm_fn() {
+        return [this](const httplib::Request& req, httplib::Response& res, const std::string& t,
+                      const std::string& o) -> bool { return ar->require_permission(req, res, t, o); };
+    }
+    auto fleet_read_fn() {
+        return [this](const httplib::Request& req, httplib::Response& res, const std::string& t,
+                      const std::string& o) -> authz::FleetReadGate {
+            auto result = ar->require_fleet_read(req, res, t, o);
+            if (!result)
+                return {};
+            return {true, result->visible_for_query()};
+        };
+    }
+    auto audit_fn() {
+        return [this](const httplib::Request&, const std::string& a, const std::string& r,
+                      const std::string& tt, const std::string& ti, const std::string& d) -> bool {
+            audits.push_back({a, r, tt, ti, d});
+            return audit_ok;
+        };
+    }
+};
+
+struct Resp {
+    int status{0};
+    std::string body;
+};
+
+std::string describe_scope(const authz::FleetReadGate& g) {
+    if (!g.admitted)
+        return "DENIED";
+    if (!g.scope)
+        return "ADMIT-ALL(unfiltered)";
+    std::string s = "SCOPED{";
+    for (auto& a : *g.scope)
+        s += a + ",";
+    return s + "}";
+}
