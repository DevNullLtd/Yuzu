+TEST_CASE("confprobe: legacy /api/responses audit asymmetry vs v1 twin", "[pg][confprobe]") {
+    YUZU_REQUIRE_PG_DB_TPL(db, confprobe_tpl);
+    Rig r{db.dsn()};
+    out_line("=== LEGACY RESPONSES AUDIT ===");
+    auto bob = r.mint("bob");
+    auto gary = r.mint("gary");
+
+    for (auto [who, tok] : std::vector<std::pair<std::string, std::string>>{{"bob(scoped)", bob},
+                                                                            {"gary(global)", gary}}) {
+        for (bool audit_ok : {true, false}) {
+            r.audit_ok = audit_ok;
+            for (std::string path : {"/api/responses/cmd-1", "/api/responses/cmd-1/aggregate"}) {
+                r.audits.clear();
+                auto lg = call_legacy_resp(r, path, tok);
+                std::string rows;
+                for (auto& a : r.audits)
+                    rows += a.action + "/" + a.result + "(" + a.detail + ") ";
+                out_line("legacy " + path + " principal=" + who + " audit_persists=" +
+                         (audit_ok ? "yes" : "NO") + " -> status=" + std::to_string(lg.status) +
+                         " out_of_scope_data=" + (has(lg.body, "SECRET-OUT") ? "YES" : "no") +
+                         " in_scope_data=" + (has(lg.body, "IN-OUTPUT") || has(lg.body, "groups") ? "yes" : "no") +
+                         " audit_rows=[" + rows + "]");
+                std::string v1path = path.rfind("/aggregate") != std::string::npos
+                                         ? "/api/v1/responses/cmd-1/aggregate"
+                                         : "/api/v1/responses/cmd-1";
+                r.audits.clear();
+                V1 v1{r};
+                auto vr = v1.get(v1path, tok);
+                rows.clear();
+                for (auto& a : r.audits)
+                    rows += a.action + "/" + a.result + "(" + a.detail + ") ";
+                out_line("  v1 twin " + v1path + " principal=" + who + " audit_persists=" +
+                         (audit_ok ? "yes" : "NO") + " -> status=" + std::to_string(vr.status) +
+                         " out_of_scope_data=" + (has(vr.body, "SECRET-OUT") ? "YES" : "no") +
+                         " audit_rows=[" + rows + "]");
+            }
+        }
+    }
+}
