+TEST_CASE("confprobe: engine principals (RBAC ON)", "[pg][confprobe]") {
+    YUZU_REQUIRE_PG_DB_TPL(db, confprobe_tpl);
+    Rig r{db.dsn()};
+    EnginePrincipalStore eps{r.pool};
+    REQUIRE(eps.is_open());
+    r.ar->set_engine_principal_store(&eps);
+    r.api_tokens->set_engine_referent_check(
+        [&](const std::string& id) { return eps.get_for_auth(id).status; });
+    {auto c = eps.create("Probe A", "gary", "probe", "internal", "admin", "engine:probea"); const std::string cerr_ = c ? std::string{} : c.error(); INFO(cerr_); REQUIRE(c.has_value());}
+    REQUIRE(eps.create("Probe B", "gary", "probe", "internal", "admin", "engine:probeb").has_value());
+    // B holds a GLOBAL Execution:Read grant, A holds nothing.
+    REQUIRE(r.rbac.assign_role({"engine", "engine:probeb", "ExecReadG"}).has_value());
+    REQUIRE(r.rbac.assign_role({"engine", "engine:probeb", "InfraReadG"}).has_value());
+    auto ta = r.api_tokens->create_token("e", "engine:probea", now_epoch() + 3600, "", "readonly", "engine");
+    auto tb = r.api_tokens->create_token("e", "engine:probeb", now_epoch() + 3600, "", "readonly", "engine");
+    REQUIRE(ta.has_value());
+    REQUIRE(tb.has_value());
+    out_line("=== ENGINE (RBAC ON) ===");
+    probe_principal(r, "RBAC-ON", {"P_engine(no grant)", *ta});
+    probe_principal(r, "RBAC-ON", {"P_engine(global Execution:Read)", *tb});
+}
