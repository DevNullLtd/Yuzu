{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "yuzu",
  "version": "0.1.0",
  "description": "Multi-platform agent and server framework",
  "homepage": "https://github.com/DevNullLtd/Yuzu",
  "license": "AGPL-3.0-or-later",
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "dependencies": [
    {
      "name": "grpc",
      "features": ["codegen"]
    },
    "protobuf",
    {
      "name": "abseil",
      "version>=": "20240116.1"
    },
    "spdlog",
    "nlohmann-json",
    "cli11",
    "cpp-httplib",
    "sqlite3",
    "openssl",
    "zlib",
    {
      "name": "libxml2",
      "default-features": false
    }
  ],
  "default-features": ["server", "tests"],
  "features": {
    "server": {
      "description": "Dependencies of server/core only; agent-only builds opt out with --x-no-default-features",
      "dependencies": [
        {
          "name": "libpq",
          "default-features": false,
          "features": ["openssl"]
        },
        "xmlsec",
        {
          "name": "drogon",
          "default-features": false
        },
        "libxlsxwriter"
      ]
    },
    "agent": {
      "description": "Agent-only dependencies (none today; placeholder so a future agent-only port has a home)"
    },
    "tests": {
      "description": "Unit-test dependencies (-Dbuild_tests=true)",
      "dependencies": [
        {
          "name": "catch2",
          "platform": "x64 | arm64"
        }
      ]
    }
  },
  "$overrides-comment": "Security pins above the baseline (WP14): brotli 1.2.1 (CVE-2026-111497) and sqlite3 3.54.1 (the 3.54.0 CVE batch). An override is an exact pin that also holds a port BACK, so delete each entry once the baseline reaches that version; see docs/build-guide.md (vcpkg).",
  "overrides": [
    { "name": "brotli", "version": "1.2.1" },
    { "name": "sqlite3", "version": "3.54.1" }
  ]
}
