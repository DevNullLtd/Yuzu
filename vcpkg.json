{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "yuzu",
  "version": "0.1.0",
  "description": "Multi-platform agent and server framework",
  "homepage": "https://github.com/DevNullLtd/Yuzu",
  "license": "AGPL-3.0-or-later",
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "dependencies": [
    {
      "name": "grpc",
      "features": ["codegen"]
    },
    "protobuf",
    {
      "name": "abseil",
      "version>=": "20240116.1"
    },
    "spdlog",
    "nlohmann-json",
    "cli11",
    "cpp-httplib",
    "sqlite3",
    {
      "name": "libpq",
      "default-features": false,
      "features": ["openssl"]
    },
    "openssl",
    {
      "name": "catch2",
      "platform": "x64 | arm64"
    },
    {
      "name": "libxml2",
      "default-features": false
    },
    "xmlsec",
    "zlib",
    {
      "name": "drogon",
      "default-features": false
    }
  ],
  "overrides": []
}
