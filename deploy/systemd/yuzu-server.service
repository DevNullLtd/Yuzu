[Unit]
Description=Yuzu Endpoint Management Server
Documentation=https://github.com/DevNullLtd/Yuzu
# postgresql.service ordering is SOFT (Wants=, not Requires=): a missing
# unit in Wants= is silently ignored, so installs without a local Postgres
# — including those pointing YUZU_POSTGRES_DSN at an external/managed
# database via the EnvironmentFile below — are unaffected. When a local
# postgresql.service IS present, the server starts after it. (ADR-0006 /
# #1318; the server-side DSN consumer lands in #1320.)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
# Restart-loop guard. If the process crashes more than StartLimitBurst
# times within StartLimitIntervalSec, systemd stops restarting it and
# the unit enters `failed` state. Without this, a startup failure — e.g.
# an unreachable/misconfigured Postgres auth substrate (ADR-0006;
# authentication now lives in Postgres, not a local SQLite file), or a
# corrupt remaining SQLite store (WAL truncation, disk-full, Defender
# quarantine on Windows) failing its integrity check — would put the
# unit into a tight crash-restart loop that masks the underlying problem
# behind log noise. Operators reading `systemctl status yuzu-server` see
# a clean failure instead. For a Postgres auth-substrate failure, check
# `journalctl -u yuzu-server` for the PG connection error and verify
# YUZU_POSTGRES_DSN / the postgresql.service dependency below (auth
# recovery: docs/ops-runbooks/auth-db-recovery.md). Keys live in [Unit] in
# systemd >= 230; older releases ignore them here, which is acceptable.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=yuzu
Group=yuzu
# Optional environment file (leading '-' = no error when absent). Written
# by scripts/install-server-postgres.sh; carries YUZU_POSTGRES_DSN for
# either a locally-provisioned Postgres or an external/managed one —
# external DSNs are first-class, just edit the file. Mode 0600 yuzu:yuzu
# (the DSN embeds a credential).
EnvironmentFile=-/etc/yuzu/yuzu-server.env
# --data-dir holds the server's runtime state files (auto-approve.cfg — still
# per-replica; a pre-6.2 install's enrollment-tokens.cfg/pending-agents.cfg are
# read here exactly ONCE by the HA WS-6 6.2 importer, then renamed aside and
# never read again — enrollment/pending state itself is Postgres-authoritative,
# see docs/adr/2002-high-availability-architecture.md §8), agent-updates/ (when
# --update-dir is unset), upload-blobs/, and the NVD cache nvd_cves.db — the
# one remaining server SQLite store, a recorded deferral on ADR-0006's ladder
# (docs/postgres-migration-ladder.md). Every other server store, including
# auth, sessions and account lockout, lives in the Postgres substrate
# (YUZU_POSTGRES_DSN / EnvironmentFile above); legacy *.db files left here
# by older releases are only probed at startup to warn, never read.
# /var/lib/yuzu matches StateDirectory, WorkingDirectory, and the
# ReadWritePaths grant below.
ExecStart=/usr/local/bin/yuzu-server \
    --listen 0.0.0.0:50051 \
    --gateway-upstream 0.0.0.0:50055 \
    --web-port 8080 \
    --data-dir /var/lib/yuzu
Restart=on-failure
RestartSec=5
# Graceful-stop budget. Two background rollup threads (app-perf B1->B2 and the
# /inventory catalogue rollup) are joined sequentially during shutdown, and a join
# cannot cancel an in-flight Postgres recompute — it waits for the statement to return
# (bounded by each thread's SET LOCAL statement_timeout: app-perf 120s + catalogue 60s).
# Stock systemd's 90s default would SIGKILL mid-recompute (data-safe — the txn rolls back
# and keep-last-good holds — but it logs as a hard kill, which is operationally noisy).
# 210s clears the worst-case sequential sum with margin. Raise if either rollup budget grows.
# Also covers a SEPARATE, coincidentally similar bound: MCP streamed POST's worst-case
# drain is ~156s (120s response cap + pump ticks + the 30s socket write timeout, see
# docs/user-manual/server-admin.md "Sizing"). The two constraints share this one value by
# coincidence, not by design — raising it for the rollup budget alone still covers MCP;
# don't LOWER it without checking both. A THIRD, independent reason this value must not drop
# below a few seconds (#4666 PR-4): the T_server dedicated async logger's exit-time worker
# join has no self-armed watchdog, so a stalled log sink leaves it bounded ONLY by a second
# SIGTERM or this deadline — see guardian_ingest.hpp's own header banner.
TimeoutStopSec=210

# File-descriptor headroom. The default 1024 soft limit is comfortably
# exhausted on a busy fleet by SSE EventSource connections + agent gRPC
# streams + SQLite WAL + log handles. 65536 matches the Linux kernel's
# fs.nr_open default and gives single-server deployments room to grow
# beyond ~16k concurrent agent connections.
LimitNOFILE=65536

WorkingDirectory=/var/lib/yuzu
StateDirectory=yuzu
LogsDirectory=yuzu
ConfigurationDirectory=yuzu

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yuzu /var/log/yuzu /etc/yuzu
PrivateTmp=true

[Install]
WantedBy=multi-user.target
