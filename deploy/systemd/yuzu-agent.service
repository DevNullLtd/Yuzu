[Unit]
Description=Yuzu Endpoint Management Agent
Documentation=https://github.com/DevNullLtd/Yuzu
After=network-online.target
Wants=network-online.target

# Crash-loop backstop (ADR-0021 rung 7.7a). Restart=always + RestartSec=10 would
# otherwise restart forever; paired with the Guardian F3 orphan-exit (hard_exit on a
# wedged I/O worker), a permanently-wedged watched target could restart-wedge-exit
# every 10s indefinitely. If 5 starts occur within 300s systemd stops retrying and
# enters `failed` (which alerts) instead of looping. The primary defense against a
# single wedged read is still degrade-and-skip-that-rule inside the agent (rung 7.7b);
# this is the belt-and-braces so a regression pages rather than loops silently.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=yuzu-agent
Group=yuzu-agent
# Optional environment file (leading '-' = no error when absent). Deliberately under
# /etc/yuzu-agent/, NOT the shared /etc/yuzu/ (docs/agent-privilege-model.md's existing
# convention for agent-dedicated config, matching agent.cfg/cert/ - "dedicated", not
# "owned": this file is root:root, tighter than those siblings' root:agent, see below):
# on a host that also runs yuzu-server, the server .deb/.rpm postinst re-asserts
# /etc/yuzu as 0750 yuzu:yuzu on every install/upgrade, and directory-write lets that
# DIFFERENT service account unlink or replace any file inside regardless of the file's
# own mode - a root:root 0600 file under /etc/yuzu is not actually confined against the
# server account. /etc/yuzu-agent/ has no such collision. Not shipped by the .deb/.rpm -
# create it by hand, root:root 0600 (protects at rest and stops the yuzu-agent account
# altering its own boot posture too - stricter than agent.cfg/cert's root:agent 0640
# because systemd reads this one as root pre-exec, so the agent process never needs
# read access to it at all; not a secrets channel regardless - the agent still inherits
# every value it sets). Persists deploy-time YUZU_* settings across
# restarts and upgrades, chiefly YUZU_AGENT_SPARK_DISABLE=1, the prefer_spark rollback
# lever (#3851; see docs/user-manual/guaranteed-state.md "SparkEngine"). A missing or
# unreadable file is silently skipped - rollback then silently does NOT apply, verify
# via /proc, don't trust file-presence alone. A present file with a malformed VALUE
# makes the agent fail to start instead. Re-enable = remove the assignment.
EnvironmentFile=-/etc/yuzu-agent/yuzu-agent.env
# Hardware table snapshot (DMI + SMBIOS entry point), rebuilt at every start.
# 1. The first line removes any old snapshot as the service account, so a failed
#    refresh never leaves a stale one behind.
# 2. The second line runs ONLY the helper as root ('+' = outside the sandbox) because
#    the firmware tables are root-only; root just reads, and every write into the
#    agent-writable state directory is done by the helper as the service account.
# A leading '-' makes a failed step non-fatal: the agent still starts, without a
# snapshot. It does not absorb a step that runs past TimeoutStartSec, which fails the
# start. The helper is installed by the .deb and .rpm; a unit copied without it
# simply gets no snapshot, for the same reason. The unit is designed for systemd 239
# and later; 239 is untested.
ExecStartPre=-/bin/rm -rf /var/lib/yuzu-agent/dmi /var/lib/yuzu-agent/dmi.tmp
ExecStartPre=-+/bin/bash /usr/share/yuzu/scripts/yuzu-agent-dmi-snapshot.sh /var/lib/yuzu-agent yuzu-agent
ExecStart=/usr/local/bin/yuzu-agent \
    --server %H:50051 \
    --plugin-dir /usr/lib/yuzu/plugins \
    --data-dir /var/lib/yuzu-agent
Restart=always
RestartSec=10
WorkingDirectory=/var/lib/yuzu-agent
StateDirectory=yuzu-agent

# Security hardening
NoNewPrivileges=true
# CAP_DAC_READ_SEARCH lets the agent read root-only files, chiefly the 0400 DMI
# serial and UUID under /sys/class/dmi/id. It is granted as an ambient capability and
# the bounding set is exactly this one capability, so no other capability can be gained.
# Every plugin runs in the agent process, so every plugin can now read ANY file on the
# host. The capability grants no permission to write file contents and no other
# capability bit; it also authorizes open_by_handle_at(2) and linkat(2) with
# AT_EMPTY_PATH, which neither the agent nor its bundled plugins call. The agent clears its
# inheritable and ambient sets at start, so an ordinary exec'd child (a script,
# dmidecode) has no capabilities after execve.
# To opt out, see docs/user-manual/upgrading.md.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectSystem=strict
ReadWritePaths=/var/lib/yuzu-agent
PrivateTmp=true

[Install]
WantedBy=multi-user.target
