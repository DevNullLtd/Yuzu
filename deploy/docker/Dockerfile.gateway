# syntax=docker/dockerfile:1.7
# Yuzu Gateway — Erlang/OTP Docker build with dependency caching
#
# The build uses three stages so that rebar3 dependency fetching and
# compilation are cached separately from application code.
#
# BuildKit cache mounts further accelerate rebuilds:
#   - /root/.cache/rebar3  — downloaded Hex packages (shared across builds)
#
# Requires BuildKit (default since Docker 23). Plain `docker build` works.
#
# Quick rebuild (code-only):
#   docker build -t yuzu-gateway -f deploy/docker/Dockerfile.gateway .
#
# Pre-bake the deps image (linux/amd64 only, see "Supported platforms" below):
#   docker build --target deps -t yuzu-gateway-deps -f deploy/docker/Dockerfile.gateway .
#   docker build -t yuzu-gateway -f deploy/docker/Dockerfile.gateway .

# ── Supported platforms (#6711) ───────────────────────────────────────────
#
# linux/amd64 ONLY: the platform the release builds, publishes and tests
# (release.yml builds the gateway image for linux/amd64 alone). No other
# platform of this image is built or tested anywhere, so the first RUN below
# refuses it up front rather than produce an untested image.
#
# The builder is hexpm/erlang (WP15, owner ruling 2026-11-18): its tag names
# the exact OTP and Alpine release (28.5.0.8 on Alpine 3.23.8), and every
# platform of the pinned index is built on that one Alpine release (its first
# history entry is `ADD alpine-minirootfs-3.23.8-<arch>.tar.gz`, checked for
# amd64 and arm64 on 2026-11-20). The upstream erlang:28-alpine index this
# replaced was mixed (amd64 on Alpine 3.23, arm64 on 3.24), which is what
# first restricted the image to amd64 (#6711).
#
# Before adding a platform: build and boot it, and keep the runtime stage on
# the builder's Alpine release (the abi-guard below enforces it for the
# platform being built, after the whole rebar3 build). The marker line is read
# by scripts/ci/check-gateway-base-index.py, which fails when a listed platform
# is not shown, in the pinned index, as built on the runtime stage's Alpine
# release (by the entry's base-name annotation or, failing that, the minirootfs
# its image config records) or when the builder tag names another Alpine
# release; add a platform to the marker and to the guard below together. The
# guard treats an unset TARGETARCH (a builder that does not set it) as amd64;
# the abi-guard below still stops a build whose Alpine or musl differs.
# yuzu:gateway-platforms linux/amd64

# ── Stage 1: deps — fetch and compile Erlang dependencies (cached) ────────
# Erlang/OTP 28.5.0.8 on Alpine 3.23.8. The digest is the multi-arch index's,
# resolved with `docker buildx imagetools inspect
# hexpm/erlang:28.5.0.8-alpine-3.23.8` on 2026-11-20. The release's ERTS comes
# from this image (`include_erts`), so this pin IS the OTP the gateway ships.
# Trust basis: trust on first use. hexpm publishes no signature for its images,
# so the digest proves only that every build uses the bytes resolved that day;
# scripts/ci/check-gateway-base-index.py and the abi-guard check the Alpine
# release and musl, not the publisher, and the release image gate scans the
# result. Re-resolve and review the digest on every bump, and set the same OTP
# in scripts/ci/image-vuln-gate.sh's GRYPE_REQUIRED_COMPONENTS (a test checks
# they agree).
FROM hexpm/erlang:28.5-alpine-3.23.4@sha256:77e27750739a891ae545489134917a38a4e1210f54d532408c7b4085bc8accce AS deps

# BuildKit sets TARGETARCH from --platform (and from the host when it is not
# given). Keep the allowed set in step with the marker line above.
ARG TARGETARCH
RUN case "${TARGETARCH:-amd64}" in amd64) ;; *) \
      echo "FATAL: Dockerfile.gateway supports linux/amd64 only (TARGETARCH=${TARGETARCH})." \
           "It is the only platform the release builds, publishes and tests; another platform needs" \
           "a build-and-boot check and the runtime stage on the builder's Alpine release (#2150)." \
           "Build with --platform linux/amd64 (on an arm64 host that is emulation, which has crashed in" \
           "the Erlang deps stage under OrbStack; prefer an amd64 host or CI)." \
           "See #6711 and docs/operations/troubleshooting.md." \
           "A single-node demo can use deploy/docker/Dockerfile.gateway.chisel (demo variant: no" \
           "gateway-entrypoint.sh, so it cannot resolve its own cluster advertise address; do not use" \
           "it for a scaled or clustered gateway)."; \
      exit 1;; esac

RUN apk add --no-cache git

# rebar3: the hexpm image ships Erlang/OTP only. Pinned by version AND sha256:
# BuildKit verifies --checksum before the file is used, and fails the build on
# a mismatch. 3.27.3 (published 2026-10-12) is the newest release at least a
# month old; its bytes' SLSA provenance was verified on 2026-11-20 with
#   cosign verify-blob-attestation --bundle rebar3.sigstore \
#     --certificate-oidc-issuer https://token.actions.githubusercontent.com \
#     --certificate-identity \
#       https://github.com/erlang/rebar3/.github/workflows/publish.yml@refs/tags/3.27.3 \
#     --type slsaprovenance1 rebar3
# after downloading both `rebar3` and `rebar3.sigstore` from the 3.27.3 release
# page; `sha256sum rebar3` gives the checksum below. Bump the URL, the checksum
# and the version check below together, and re-verify the provenance.
ADD --checksum=sha256:f1d87d78decfc56b87d971c75ee6355698ec0c49fadd57f2c056043b7ca291b5 --chmod=755 \
    https://github.com/erlang/rebar3/releases/download/3.27.3/rebar3 /usr/local/bin/rebar3
RUN rebar3 version | grep -q '^rebar 3\.27\.3 on Erlang/OTP 28 '

WORKDIR /src

# Copy only dependency manifests — this layer caches until deps change
COPY gateway/rebar.config gateway/rebar.lock ./

# Fetch and compile deps (but not app code). The rebar3 global cache holds
# downloaded Hex package tarballs; mounting it skips the network round-trip
# when the layer cache is cold but the packages themselves are unchanged.
RUN --mount=type=cache,target=/root/.cache/rebar3 \
    rebar3 compile --deps_only

# ── Stage 2: build — copy app source and build release ────────────────────
FROM deps AS builder

# Copy the rest of the gateway source
COPY gateway/ .

RUN rebar3 as prod release

# Record the build-side ABI facts the runtime stage's guard checks (#2150).
# The musl version comes from the dynamic loader itself, so it is the libc the
# release was linked against, not a package-database claim.
RUN { echo "BUILD_ALPINE=$(cut -d. -f1,2 /etc/alpine-release)"; \
      echo "BUILD_MUSL=$(/lib/ld-musl-*.so.1 2>&1 | sed -n 's/^Version //p')"; \
      echo "BUILD_OTP=$(cat "$(erl -noshell -eval 'io:format("~s", [code:root_dir()]), halt().')"/releases/*/OTP_VERSION)"; \
    } > /build-abi.env && cat /build-abi.env

# ── Stage 3: Runtime — MUST be the builder's Alpine release (#2150) ──────
#
# Two reasons. The guard RUN below fails the build when the Alpine release or
# the musl version differs, which covers the second directly and the first by
# proxy:
#
#  1. OpenSSL ABI. The crypto NIF in the release was built against the
#     builder's libcrypto.so.3. The runtime's libcrypto3 comes from the
#     `apk add` below, from the same Alpine release branch, so the soname and
#     the 3.x ABI match even when the patch level differs.
#
#  2. musl's sigaltstack() check. ERTS (OTP 28) sizes its alternate signal
#     stack with the compile-time constant SIGSTKSZ (8192 on x86_64). musl
#     1.2.6 (Alpine 3.24) rejects any size below sysconf(_SC_MINSIGSTKSZ),
#     which comes from the kernel's AT_MINSIGSTKSZ. That value exceeds 8192 on
#     AMX-capable Intel CPUs (Sapphire Rapids and newer: AWS c7i/m7i/r7i), so
#     beam.smp aborts at boot with "sys_sigaltstack(): Internal error: Failed
#     to set alternate signal stack" (#1743). musl 1.2.5 checks a fixed
#     constant and accepts it. Rebuilding against 1.2.6 does NOT help: SIGSTKSZ
#     is still 8192 there. The fix is in ERTS (erlang/otp#11249, #11376), first
#     released in OTP 29.1; no OTP 28 or 29.0.x release carries it.
#
# So: keep this FROM on the builder's Alpine release (the hexpm builder above
# is on 3.23.8). Do not move to Alpine 3.24 (musl 1.2.6) until the builder's
# OTP is 29.1 or newer. Dependabot is told to ignore Alpine minor bumps for
# this reason (.github/dependabot.yml). If the builder is ever re-pinned to a
# 3.24-based image while still on OTP 28, the guard fails the build rather
# than ship an image that crash-loops on AMX hosts.
#
# RUNTIME INVARIANT: busybox wget is required by docker-compose.uat.yml's
# healthcheck (`wget --spider -q http://localhost:8081/healthz`). Alpine's
# busybox provides wget with --spider. Do not switch this base
# image to a wget-less variant or strip busybox without first updating every
# compose file's healthcheck block to use a tool the new base provides.
# Governance Gate 7, architect SHOULD-2.
#
# ENFORCED (#751): scripts/ci/verify-healthcheck-invariants.sh runs
# `wget --spider` against a live listener inside this image before release.yml
# pushes it, and on every PR that touches this file. NOTE: Alpine's busybox is
# built WITHOUT the httpd applet, so it cannot serve the probe's listener — the
# script uses the official busybox image for that.
FROM alpine:3.23@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2

# Current Alpine 3.23 packages (WP15/S9). The base digest is only as fresh as
# the day it was built, so every release build takes the 3.23 branch's fixes
# (musl, zlib, ...). It runs BEFORE the abi-guard so the guard checks the musl
# that ships. An upgrade stays on the 3.23 branch, so it cannot cross to musl
# 1.2.6 (and if a 3.23 update ever did, the guard fails the build). The release
# scans this image for fixable CRITICAL vulnerabilities before pushing it
# (release.yml, scripts/ci/image-vuln-gate.sh).
# YUZU_PACKAGE_REFRESH: release.yml passes a value that changes on every run
# attempt, so the package step below re-runs instead of being served from the
# runner's persistent build cache (cache-from type=local; cache-prune.yml only
# removes blobs no cache index references, so a referenced package layer stays
# cached indefinitely), which would otherwise keep shipping the packages of
# whichever build first populated it. Local builds leave it empty and cache as usual.
ARG YUZU_PACKAGE_REFRESH=
RUN : "package refresh: ${YUZU_PACKAGE_REFRESH}" && apk upgrade --no-cache

# Builder/runtime ABI guard (#2150). See the stage header above for why.
# Every version is first required to be a plain dotted number: `apk version -t`
# prints nothing for anything else (an OTP release candidate "29.0-rc1", a
# patched "28.5.0.8**"), and an empty comparison must never read as "not
# older"; each comparison must then be exactly one of < = >. Two OTP_VERSION
# files in the builder put a bare line in the env file, which fails the build
# at the `.` (command not found) before any of this runs. otp_fix_min is the
# first OTP release whose ERTS sizes the signal stack from
# sysconf(_SC_MINSIGSTKSZ); lower it only if an OTP 28 release gains the
# backport. tests/test_gateway_abi_guard.py runs this step's text, so keep
# the paths it reads where they are.
RUN --mount=type=bind,from=builder,source=/build-abi.env,target=/tmp/build-abi.env \
    set -eu; . /tmp/build-abi.env; \
    otp_fix_min=29.1; \
    rt_alpine=$(cut -d. -f1,2 /etc/alpine-release); \
    rt_musl=$(/lib/ld-musl-*.so.1 2>&1 | sed -n 's/^Version //p'); \
    echo "abi-guard: builder Alpine $BUILD_ALPINE musl $BUILD_MUSL OTP $BUILD_OTP; runtime Alpine $rt_alpine musl $rt_musl"; \
    for v in "$BUILD_ALPINE" "$BUILD_MUSL" "$BUILD_OTP" "$rt_alpine" "$rt_musl"; do \
      case "$v" in ''|*[!0-9.]*|.*|*.|*..*) \
        echo "FATAL: abi-guard: '$v' is not a plain dotted version, so builder and runtime cannot be compared. See the abi-guard line above and docs/operations/troubleshooting.md, Gateway image build fails at abi-guard."; \
        exit 1;; esac; \
    done; \
    if [ "$rt_alpine" != "$BUILD_ALPINE" ] || [ "$rt_musl" != "$BUILD_MUSL" ]; then \
      echo "FATAL: abi-guard: runtime Alpine/musl ($rt_alpine/$rt_musl) differs from the builder's" \
           "($BUILD_ALPINE/$BUILD_MUSL). Move the runtime FROM to the builder's Alpine release; see docs/operations/troubleshooting.md."; \
      exit 1; fi; \
    musl_vs=$(apk version -t "$rt_musl" 1.2.6 || true); \
    otp_vs=$(apk version -t "$BUILD_OTP" "$otp_fix_min" || true); \
    for c in "$musl_vs" "$otp_vs"; do \
      case "$c" in '<'|'='|'>') ;; *) \
        echo "FATAL: abi-guard: could not compare versions (apk printed '$musl_vs' '$otp_vs')."; exit 1;; esac; \
    done; \
    if [ "$musl_vs" != "<" ] && [ "$otp_vs" = "<" ]; then \
      echo "FATAL: abi-guard: musl $rt_musl with OTP $BUILD_OTP: beam.smp aborts at boot on AMX CPUs" \
           "(sys_sigaltstack internal error, #1743). Needs OTP >= $otp_fix_min or musl < 1.2.6; see docs/operations/troubleshooting.md."; \
      exit 1; fi

# zlib: the hexpm-built beam.smp links the system libz.so.1 (the erlang:28-alpine
# one did not); declared so a slimmer base cannot drop it.
RUN apk add --no-cache ncurses-libs libstdc++ libgcc openssl zlib \
    # bind-tools (dig) + iproute2: HA WS-4 #4555 — gateway-entrypoint.sh
    # resolves this node's own advertised distribution address by DNS-A-record
    # lookup + local-interface intersection BEFORE the BEAM starts. Busybox's
    # built-in `ip` applet output format is not guaranteed stable enough for
    # this to parse reliably; `dig +short` is far easier to parse correctly
    # than busybox nslookup's output. See gateway-entrypoint.sh's own header
    # comment for the full resolution order.
    && apk add --no-cache bind-tools iproute2 \
    && adduser -D -s /sbin/nologin yuzu-gw \
    # Shared cert group (PKI #1289): FIXED gid 2000, identical across server/
    # gateway/agent so the gateway (a different uid) reads the shared CA + its leaf
    # key out of /etc/yuzu/certs when the server runs with --cert-group yuzu-pki.
    && addgroup -g 2000 yuzu-pki \
    && addgroup yuzu-gw yuzu-pki

COPY --from=builder /src/_build/prod/rel/yuzu_gw/ /opt/yuzu_gw/
COPY --chmod=755 deploy/docker/gateway-entrypoint.sh /opt/yuzu_gw/gateway-entrypoint.sh
COPY --chmod=644 deploy/docker/gateway-cookie-policy.sh /opt/yuzu_gw/gateway-cookie-policy.sh
RUN chown -R yuzu-gw:yuzu-gw /opt/yuzu_gw

USER yuzu-gw
WORKDIR /opt/yuzu_gw

EXPOSE 50051 50063 8081 9568

ENTRYPOINT ["/opt/yuzu_gw/gateway-entrypoint.sh"]
CMD ["foreground"]
