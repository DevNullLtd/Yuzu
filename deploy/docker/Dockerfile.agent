# Yuzu Agent — Multi-stage Docker build
# Build:  docker build -t yuzu-agent -f deploy/docker/Dockerfile.agent .
# Run:    docker run --network host yuzu-agent --server localhost:50051 --no-tls

# ── Stage 1: Build ────────────────────────────────────────────────────────
FROM ubuntu:26.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03 AS builder

# TRIPLET selects the vcpkg target. Pass --build-arg TRIPLET=arm64-linux for
# arm64; default keeps the historical x64 build path.
ARG TRIPLET=x64-linux
ARG YUZU_BUILD_JOBS=

# Base: ubuntu:26.04 (Resolute) — the same OS and GCC 15 toolchain as the Big
# Tam self-hosted Linux CI pool (#5929); see Dockerfile.server for why the
# previous debian:trixie-slim + gcc-13 base was dropped (trixie has no gcc-15).
# mold is required by meson/native/linux-gcc15.ini (-fuse-ld=mold).
COPY deploy/docker/requirements-meson.txt /tmp/requirements-meson.txt
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build gcc-15 g++-15 mold pkg-config make linux-libc-dev \
    curl zip unzip tar git ca-certificates \
    bison flex libsystemd-dev libblkid-dev \
    autoconf automake libtool \
    python3-pip python3-venv python3-yaml \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-15 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-15 100 \
    && update-alternatives --install /usr/bin/cc  cc  /usr/bin/gcc-15 100 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-15 100 \
    && pip3 install --break-system-packages --require-hashes -r /tmp/requirements-meson.txt \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/microsoft/vcpkg.git /opt/vcpkg \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics
ENV VCPKG_ROOT=/opt/vcpkg

WORKDIR /src
COPY vcpkg.json vcpkg-configuration.json ./
RUN /opt/vcpkg/vcpkg install --triplet ${TRIPLET} --x-manifest-root=.

COPY . .
# LTO is intentionally OFF for the agent (no -Db_lto=true below). History:
# with gcc-13 on debian:trixie, linking the executable across the DSO
# boundary (libyuzu_agent_core.so) plus the static yuzu_proto archive under
# LTO hit Debian binutils 2.43+ undefined-reference errors on protobuf type
# ctors/dtors; the same gcc-13 + binutils on Ubuntu noble had swallowed the
# mismatch silently. The image now builds with gcc-15 on Ubuntu 26.04 and
# links with mold (meson/native/linux-gcc15.ini). ci.yml's gcc-15 release leg
# already links the whole tree, agent included, with -Db_lto=true on that same
# toolchain, which suggests the failure no longer reproduces there — but the
# image build has not been switched to LTO or tested with it, so it stays off
# here (Dockerfile.server does not enable LTO either). The proper fix for the
# original failure is to propagate -flto into yuzu_proto's archive build.
RUN meson setup builddir \
    --native-file meson/native/linux-gcc15.ini \
    --buildtype=release \
    -Dcmake_prefix_path=/src/vcpkg_installed/${TRIPLET} \
    -Dpkg_config_path=/src/vcpkg_installed/${TRIPLET}/lib/pkgconfig \
    -Dbuild_tests=false \
    -Dbuild_server=false \
    && meson compile -C builddir ${YUZU_BUILD_JOBS:+-j "${YUZU_BUILD_JOBS}"}

# ── Stage 2: Runtime ──────────────────────────────────────────────────────
# Same OS release as the builder (ubuntu:26.04, same digest): the agent, its
# core DSO and every plugin link libstdc++/libgcc_s/libc dynamically. Measured
# on the arm64 build at #5929 they need only GLIBC_2.38, GLIBCXX_3.4.32 and
# CXXABI_1.3.15 (yuzu-server, built the same way, already needs GCC 15's
# GLIBCXX_3.4.34), but nothing stops the next change from pulling in a GCC 15
# symbol, so the runtime pairs with the builder's release rather than relying
# on that. Static libstdc++ is not an option here — the executable, the core
# DSO and each plugin DSO would each get a private copy (#5929).
# libssl3t64 is the 26.04 (64-bit time_t) name of trixie's libssl3.
# `useradd -r yuzu-agent` still allocates uid/gid 999 on ubuntu:26.04, as on
# debian:trixie-slim (checked 2026-10-16), so an agent data volume written by
# a pre-#5929 image stays owned by the runtime user after an upgrade.
FROM ubuntu:26.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3t64 libsqlite3-0 libsystemd0 libblkid1 ca-certificates bash \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -s /usr/sbin/nologin yuzu-agent \
    # Cert group (PKI #1289): FIXED gid 2000, identical across server/gateway/
    # agent. The agent mounts a volume holding the public install CA
    # (default-ca.pem) at /etc/yuzu/certs.
    && groupadd -g 2000 yuzu-pki \
    && usermod -aG yuzu-pki yuzu-agent \
    && mkdir -p /var/lib/yuzu-agent /usr/lib/yuzu/plugins \
    && chown yuzu-agent:yuzu-agent /var/lib/yuzu-agent

COPY --from=builder /src/builddir/agents/core/yuzu-agent /usr/local/bin/
COPY --from=builder /src/builddir/agents/core/libyuzu_agent_core.so /usr/local/lib/
COPY --from=builder /src/builddir/agents/plugins/ /usr/lib/yuzu/plugins/

RUN ldconfig

USER yuzu-agent
WORKDIR /var/lib/yuzu-agent

ENTRYPOINT ["yuzu-agent"]
CMD ["--server", "yuzu-server:50051", "--plugin-dir", "/usr/lib/yuzu/plugins", "--data-dir", "/var/lib/yuzu-agent"]
