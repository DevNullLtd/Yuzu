# WS-13 13.0 spike - CoreDNS for the agents' view of the gateway names.
#
# A STATIC zone: a dead gateway's A record is NOT withdrawn (Docker's embedded
# DNS withdraws it the instant the container dies, which would make the DNS-mode
# failover numbers optimistic against a real resolver serving a stale record).
# `shuffled` randomises the A order per query (round-robin DNS); Corefile.fixed keeps it.
.:53 {
    errors
    file /etc/coredns/db.ha.test ha.test
    loadbalance round_robin
}
