# Yuzu Docker — Environment Variables
# Use with: docker run --env-file docker.env ...
# Or in docker-compose.yml: env_file: [docker.env]

# Server
YUZU_WEB_ADDRESS=0.0.0.0
YUZU_WEB_PORT=8080
YUZU_LISTEN_ADDRESS=0.0.0.0:50051
# Gateway upstream. The default server image runs with TLS, so the gateway peer
# must be authorized: with the generated default certificates the server pins its
# own default gateway certificate automatically; with operator-supplied certificates
# set YUZU_GATEWAY_PEER_PINS or YUZU_GATEWAY_PEER_PIN_FILE, or the server refuses to boot.
# A plaintext (--no-tls) stack has no peer certificate, so it must instead set
# YUZU_INSECURE_GATEWAY_PEER=1 (this disables peer authorization; not for production).
# Do not set it together with a pin variable: that combination is refused.
# Pins are read once at boot; changing them needs a server restart.
YUZU_GATEWAY_UPSTREAM=0.0.0.0:50055
# YUZU_INSECURE_GATEWAY_PEER=1
YUZU_LOG_LEVEL=info
YUZU_LOG_FORMAT=json

# Agent
# YUZU_SERVER=yuzu-server:50051
# YUZU_ENROLLMENT_TOKEN=

# Secrets (set these, do not commit)
# YUZU_OIDC_CLIENT_SECRET=
# YUZU_CLICKHOUSE_PASSWORD=
