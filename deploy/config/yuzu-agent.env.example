# Yuzu Agent — Environment Variable Configuration
# Copy this file and set values. All variables are optional; defaults shown.
# CLI flags take precedence over environment variables.
# NOTE: trailing "# ..." comments are for this template only - systemd's EnvironmentFile=
# does NOT strip them; drop the comment when copying a line into an actual /etc/yuzu-agent/*.env
# file (this is the agent's own env-file directory - see yuzu-agent.service's EnvironmentFile=).

# ── Connection ───────────────────────────────────────────────────────
# YUZU_SERVER=localhost:50051            # Server address (host:port)
# YUZU_AGENT_ID=                         # Stable UUID (auto-generated if empty); a value you set may use letters, digits and . _ : -
# YUZU_ENROLLMENT_TOKEN=                 # Pre-shared enrollment token
# YUZU_ENROLLMENT_TOKEN_FILE=            # File holding the enrollment token (first line, 64 hex characters); wins over YUZU_ENROLLMENT_TOKEN. Must be owned by root or the agent's user, not group/other-writable, and readable by the agent, else it is ignored with a warning. The agent removes it after the first accepted registration, or when the server refuses the token; under the shipped systemd unit only /var/lib/yuzu-agent is writable, so put it there or the removal fails

# ── Directories ──────────────────────────────────────────────────────
# YUZU_DATA_DIR=                         # Persistent state directory (platform default)
# YUZU_PLUGIN_DIR=                       # Plugin shared library directory

# ── TLS ──────────────────────────────────────────────────────────────
# YUZU_CA_CERT=                          # PEM CA certificate for server verification
# YUZU_CLIENT_CERT=                      # PEM client certificate for mTLS
# YUZU_CLIENT_KEY=                       # PEM client private key for mTLS

# ── Windows Certificate Store ────────────────────────────────────────
# YUZU_CERT_STORE=                       # Windows cert store name (e.g. MY)
# YUZU_CERT_SUBJECT=                     # Subject CN for cert store lookup
# YUZU_CERT_THUMBPRINT=                  # SHA-1 thumbprint for cert store lookup

# ── Behavior ─────────────────────────────────────────────────────────
# YUZU_HEARTBEAT=30                      # Heartbeat interval (seconds)
# YUZU_UPDATE_CHECK_INTERVAL=21600       # OTA update check interval (seconds, 6h)
# YUZU_AGENT_SPARK_DISABLE=1            # Force the legacy detection path at next agent start (spark-flip rollback lever)
# Windows only (ignored on Linux): seconds between Registry spark rename checks; 0 or unset = OFF (default); 1-4 raised to 5; max 86400.
# WARNING: an enabled interval re-opens EVERY watched Registry key every N seconds, duplicates the held handle and reads
# canonical names; on a key with an auditing SACL that writes Security-log events (measured once on one key: 1 per check
# with Registry auditing alone, 6 with Handle Manipulation also on) and can evict older events. With it on, every
# establishment and re-arm also opens the key a second time to confirm its name (derived: one more event, four with
# Handle Manipulation on); with it off there is no second open. Leave it at 0 where SACLs audit object access; decide per estate. Rollback: unset it or set 0 and restart the agent (nothing persists). A bad value (or a trailing
# "# comment" on the line, which systemd does not strip) refuses to start the agent on every OS. Put NO trailing comment on it.
# YUZU_AGENT_SPARK_REGISTRY_PATH_VERIFY_INTERVAL=300
# YUZU_AGENT_CONTAINER_RUNTIME_ENDPOINT=          # Linux: absolute path of ONE operator-provided read-only unix socket in front of the container runtime (virtualization.runtime_posture); unset = no socket opened; never the runtime's own socket

# ── Logging ──────────────────────────────────────────────────────────
# YUZU_LOG_LEVEL=info                    # trace|debug|info|warn|error
# YUZU_LOG_FORMAT=text                   # text|json
# YUZU_LOG_FILE=                         # Log file path (enables file logging)
# YUZU_LOG_MAX_SIZE=52428800             # Max log file size in bytes (50MB)
# YUZU_LOG_MAX_FILES=5                   # Max rotated log files to keep
