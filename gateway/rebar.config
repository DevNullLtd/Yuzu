{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{deps, [
    %% grpcbox is OVERRIDDEN by a vendored patched copy in _checkouts/grpcbox (PKI
    %% PR5c — makes verify/fail_if_no_peer_cert configurable for one-way TLS on the
    %% agent listener). This git pin stays the re-sync reference; the _checkouts copy
    %% takes precedence at build time. See gateway/_checkouts/grpcbox/YUZU_PATCH.md.
    {grpcbox,    {git, "https://github.com/tsloughter/grpcbox.git", {tag, "v0.17.1"}}},
    {gpb,        "4.21.7"},
    {telemetry,  "1.3.0"},
    {prometheus, "4.11.0"},
    {prometheus_httpd, "2.1.2"},
    {recon,      "2.5.5"},
    {gproc,      "1.0.0"}
]}.

{project_plugins, [
    {gpb, "4.21.7"},
    {grpcbox_plugin, {git, "https://github.com/tsloughter/grpcbox_plugin.git", {tag, "v0.9.0"}}}
]}.

{grpc, [
    {protos, "priv/proto"},
    {gpb_opts, [
        {module_name_suffix, "_pb"},
        {i, "priv/proto"},
        use_packages,
        maps,
        strings_as_binaries,
        {maps_unset_optional, omitted},
        {report_warnings, true},
        {target_erlang_version, 26}
    ]}
]}.

{relx, [
    {release, {yuzu_gw, "0.2.0"}, [
        yuzu_gw,
        sasl
    ]},
    {mode, dev},
    {sys_config, "config/sys.config"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true}
]}.

%% The vendored grpcbox exports a type that refers to chatterbox's
%% h2_stream_set:stream_set() (the connection accessors in
%% _checkouts/grpcbox, see YUZU_PATCH.md). chatterbox is a dependency of
%% grpcbox, not a top-level dependency of this project, so dialyzer would not
%% put it in the PLT and would report the type as unknown.
{dialyzer, [
    {plt_extra_apps, [chatterbox, ssl]}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {include_erts, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {erl_opts, [debug_info, nowarn_export_all, {d, 'TEST'}]},
        %% Compile both `test/` (default) and `integration_test/` for the
        %% test profile. Suites under `integration_test/` need a real
        %% running yuzu-server upstream; the Meson/CI gate's `rebar3 ct --dir
        %% apps/yuzu_gw/test/ct` therefore won't discover them, while the
        %% `/test` pipeline (which stands up a real stack) targets
        %% `--dir apps/yuzu_gw/integration_test` explicitly.
        {extra_src_dirs, [{"integration_test", [{recursive, false}]}]},
        {ct_opts, [
            {sys_config, "config/sys.config"},
            {verbose, true}
        ]},
        {cover_enabled, true},
        {cover_opts, [verbose]}
    ]}
]}.

%% Common Test configuration
{ct_opts, [
    {logdir, "_build/test/logs"},
    {sys_config, "config/test.config"}
]}.

%% EUnit configuration
{eunit_opts, [
    verbose,
    {report, {eunit_surefire, [{dir, "_build/test/eunit"}]}}
]}.

{shell, [
    {apps, [yuzu_gw]}
]}.
