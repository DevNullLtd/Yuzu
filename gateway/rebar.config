{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{deps, [
    %% The request-context type of the gateway's own gRPC server layer
    %% (yuzu_grpc: headers, peer, connection key travel in a ctx). It used to
    %% arrive through grpcbox; it is a direct dependency now that grpcbox is gone.
    {ctx,        "0.6.0"},
    {gpb,        "4.21.7"},
    %% The gateway listeners' HTTP/2 server (yuzu_grpc_* over cowboy_stream).
    %% Pinned to a release at least a month old; ranch comes with it.
    {cowboy,     "2.19.0"},
    %% The gateway-to-server (upstream) gRPC client's HTTP/2 transport
    %% (yuzu_grpc_client over gun). ISC; needs cowlib, which cowboy brings.
    %% Pinned to a release at least a month old.
    {gun,        "2.5.0"},
    {telemetry,  "1.3.0"},
    {prometheus, "4.11.0"},
    {prometheus_httpd, "2.1.2"},
    {recon,      "2.5.5"}
]}.

{project_plugins, [
    {gpb, "4.21.7"}
]}.

%% The protobuf modules (src/*_pb.erl) are generated by regen_pb.escript, and
%% scripts/check-proto-codegen.sh (CI) regenerates them from the gpb_opts below
%% and byte-diffs. The key keeps the name `grpc' because that script reads it;
%% nothing else does any more (the rebar3 plugin that used to is gone).
{grpc, [
    {protos, "priv/proto"},
    {gpb_opts, [
        {module_name_suffix, "_pb"},
        {i, "priv/proto"},
        use_packages,
        maps,
        strings_as_binaries,
        {maps_unset_optional, omitted},
        {report_warnings, true},
        {target_erlang_version, 26}
    ]}
]}.

{relx, [
    {release, {yuzu_gw, "0.2.0"}, [
        yuzu_gw,
        sasl
    ]},
    {mode, dev},
    {sys_config, "config/sys.config"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true}
]}.

%% cowlib: yuzu_grpc_stream_h implements the cowboy_stream behaviour, whose
%% callback types (cow_http2:error/0, cow_http2:frame/0) live in cowlib; gun's
%% types reach us through the same app.
{dialyzer, [
    {plt_extra_apps, [ssl, cowlib, gun]}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {include_erts, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {erl_opts, [debug_info, nowarn_export_all, {d, 'TEST'}]},
        %% Compile both `test/` (default) and `integration_test/` for the
        %% test profile. Suites under `integration_test/` need a real
        %% running yuzu-server upstream; the Meson/CI gate's `rebar3 ct --dir
        %% apps/yuzu_gw/test/ct` therefore won't discover them, while the
        %% `/test` pipeline (which stands up a real stack) targets
        %% `--dir apps/yuzu_gw/integration_test` explicitly.
        {extra_src_dirs, [{"integration_test", [{recursive, false}]}]},
        {ct_opts, [
            {sys_config, "config/sys.config"},
            {verbose, true}
        ]},
        {cover_enabled, true},
        {cover_opts, [verbose]}
    ]}
]}.

%% Common Test configuration
{ct_opts, [
    {logdir, "_build/test/logs"},
    {sys_config, "config/test.config"}
]}.

%% EUnit configuration
{eunit_opts, [
    verbose,
    {report, {eunit_surefire, [{dir, "_build/test/eunit"}]}}
]}.

{shell, [
    {apps, [yuzu_gw]}
]}.
