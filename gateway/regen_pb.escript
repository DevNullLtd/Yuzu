#!/usr/bin/env escript
%%! -pa _build/default/plugins/gpb/ebin
-mode(compile).

%% Out-of-band pb regen for the Yuzu gateway umbrella.
%%
%% The protos live at the umbrella root (priv/proto), and no rebar3 plugin
%% generates them any more (the grpcbox_plugin that used to is gone), so this
%% script is the generator. It runs gpb_compile with the options of the
%% rebar.config {grpc,[{gpb_opts,...}]} block, which
%% scripts/check-proto-codegen.sh also reads when it regenerates and
%% byte-diffs the committed src/*_pb.erl.
%%
%% Run from the gateway/ umbrella root:
%%   /c/Erlang/erts-16.4.0.1/bin/escript.exe regen_pb.escript

main(_) ->
    GpbOpts = [{module_name_suffix, "_pb"},
               {i, "priv/proto"},
               use_packages, maps,
               strings_as_binaries,
               {maps_unset_optional, omitted},
               {report_warnings, true},
               {target_erlang_version, 26}],
    %% NOTE: the committed _pb files keep fully-qualified atoms
    %% ('yuzu.agent.v1.CommandResponse'), and all gateway Erlang references
    %% them by FQ name, so they are generated by PLAIN gpb_compile with just
    %% the rebar.config gpb_opts (no {rename,{msg_name,snake_case}} or
    %% {rename,{msg_fqname,base_name}}). Only the output dir is added.
    Opts = [{o, "apps/yuzu_gw/src"} | GpbOpts],
    Files = ["priv/proto/agent.proto",
             "priv/proto/management.proto",
             "priv/proto/gateway.proto"],
    lists:foreach(
      fun(F) ->
          io:format("regen ~s ... ", [F]),
          case gpb_compile:file(F, Opts) of
              ok ->
                  io:format("ok~n");
              {ok, Ws} ->
                  io:format("ok (~p warning(s))~n", [length(Ws)]);
              Other ->
                  io:format("ERROR ~p~n", [Other]),
                  halt(1)
          end
      end, Files),
    io:format("regen complete~n"),
    ok.
