%% yuzu_gw app-level hooks: build the malloc_trim NIF (c_src/yuzu_gw_mem_trim_nif.c)
%% into priv/ on a glibc Linux target only.
%%
%% rebar3 matches a hook's first element as a regex against the Erlang target
%% (e.g. "28.5.0.2-x86_64-pc-linux-gnu-64"). "-linux-gnu-" matches glibc Linux
%% and not Alpine/musl ("-linux-musl-"), macOS ("-apple-darwin") or Windows
%% ("win32"), so those builds need no C compiler and ship no .so; the gateway
%% then reclaims memory by garbage collection only (see yuzu_gw_mem_trim).
%%
%% The command is a script (c_src/build_mem_trim_nif.sh says why and what it
%% guarantees): on glibc Linux a missing C compiler FAILS the build.
%% docs/erlang-gateway-build.md, "The malloc_trim NIF".
{pre_hooks, [
    {"-linux-gnu-", compile, "sh c_src/build_mem_trim_nif.sh"}
]}.
{post_hooks, [
    {"-linux-gnu-", clean, "rm -f priv/yuzu_gw_mem_trim_nif.so"}
]}.
