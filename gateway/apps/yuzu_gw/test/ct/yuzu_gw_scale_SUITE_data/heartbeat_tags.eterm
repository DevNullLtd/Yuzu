%% The status_tags of the idle_memory case's heartbeats: every `yuzu.*' tag key
%% the agent core names (agents/core/src, agents/core/include; harvested
%% 2026-10-26 with grep for "yuzu.<key>" literals, less the protobuf package
%% names and yuzu.plugins_failed, which is sent only when a plugin failed),
%% with representative healthy-agent values. Not every agent sends every one
%% (the Guardian, DEX, perf and network groups are gated on what is running),
%% so this is the upper end of the core set; no per-plugin yuzu.plugin.* tags.
{tags, [
    {<<"yuzu.agent_version">>, <<"0.14.0">>},
