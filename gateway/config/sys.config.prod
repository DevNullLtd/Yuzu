%% Production configuration reference — gateway TLS posture
%% (PKI PR5 upstream mutual TLS; PR5c agent-listener one-way TLS).
%%
%% NOT auto-selected by the build: `rebar3 as prod release` uses the base relx
%% {sys_config, "config/sys.config"} unless the prod profile overrides it, and
%% the Docker images MOUNT deploy/docker/gateway-sys.config over the release
%% config at runtime. This file is the canonical, correct reference for the
%% production TLS shape -- copy it (or mount it) and adjust cert paths.
%%
%% The gateway's two listeners are the entries of {yuzu_gw, grpc_listeners}
%% below, each with its own `tls` map; the upstream channel to the C++ server is
%% the {yuzu_gw, upstream_client} entry (read by yuzu_grpc_client_config:from_env/0;
%% the client itself is yuzu_grpc_client over gun). A legacy {grpcbox, client}
%% entry is invisible to the VM and refuses boot -- move it. yuzu_gw's
%% `tls`/`tls_enabled` env (set by YUZU_GW_TLS_* in yuzu_gw_app:apply_tls_
%% overrides/0) is ADVISORY ONLY and drives neither; an env-substituted
%% sys.config.src that wires YUZU_GW_TLS_* into the config is a tracked
%% follow-up. See docs/pki-architecture.md "Gateway TLS".
%%
%% Container env overrides (handled by yuzu_gw_app:apply_env_overrides/0):
%%   YUZU_GW_UPSTREAM_ADDR / YUZU_GW_UPSTREAM_PORT — INERT: nothing applies them,
%%                            and boot logs a WARNING naming each one that is
%%                            set. The server the gateway dials is the endpoint
%%                            list of the channel in {yuzu_gw, upstream_client}
%%                            below; change the host and port there.
%%   YUZU_GW_PROMETHEUS_PORT / YUZU_GW_HEALTH_PORT — metrics / health ports
%%   YUZU_GW_AGENT_PORT / YUZU_GW_MGMT_PORT — the `listen.port' of the grpc_listeners
%%                            entry serving agent_pb / management_pb; applied only
%%                            when exactly ONE entry serves that proto (else a WARN
%%                            names the variable and it is ignored)
%%   YUZU_GW_CLUSTER_ID     — trust-zone/region cluster id (default: "default")
[
    {yuzu_gw, [
        %% Listener addresses and ports are the `listen' maps of the
        %% {grpc_listeners, ...} entries below (YUZU_GW_AGENT_PORT /
        %% YUZU_GW_MGMT_PORT set the port when exactly one entry serves that
        %% proto).

        %% Not read by anything (nor set by YUZU_GW_UPSTREAM_ADDR/PORT, which
        %% are inert): the upstream server is the endpoint list of the channel
        %% in {yuzu_gw, upstream_client} below.
        {upstream_addr, "127.0.0.1"},
        {upstream_port, 50055},

        %% Upstream connection pool size
        {upstream_pool_size, 32},

        %% Heartbeat batching interval (ms)
        {heartbeat_batch_interval_ms, 1000},

        %% Default command timeout (seconds)
        {default_command_timeout_s, 300},

        %% Prometheus metrics HTTP port
        {prometheus_port, 9568},

        %% Health/readiness HTTP port
        {health_port, 8081},

        %% Agent telemetry gauge emission interval (ms)
        {telemetry_gauge_interval_ms, 10000},

        %% Circuit breaker settings (upstream connection protection)
        {circuit_breaker_failure_threshold, 5},
        {circuit_breaker_reset_timeout_ms, 10000},
        {circuit_breaker_max_reset_timeout_ms, 300000},

        %% Stream backpressure threshold (message queue length)
        {backpressure_threshold, 1000},

        %% Consistent hash ring: virtual nodes per physical node
        {hash_ring_vnodes, 256},

        %% HA WS-4 4.1 — the trust-zone/region cluster id this gateway belongs
        %% to; agents are pinned to one cluster (ADR-2002 §7). Stamped onto
        %% every StreamStatusNotification sent upstream so the server's
        %% routing directory can record which cluster owns an agent's live
        %% stream. Override: YUZU_GW_CLUSTER_ID
        {cluster_id, <<"default">>},

        %% Mgmt-plane peer pins (#1422): the identities the :50063 auth_fun
        %% (yuzu_gw_authz:check_mgmt_peer/1, wired in grpc_listeners below)
        %% accepts. {cert_file, Path} pins to the SPKI of the cert at Path and
        %% re-reads it when the file changes (server leaf rotation self-heals);
        %% for bring-your-own-cert installs point it at YOUR server cert, or use
        %% {spki_sha256, "hex"} (openssl x509 -in cert.pem -pubkey -noout |
        %% openssl pkey -pubin -outform DER | openssl dgst -sha256). List two
        %% pins to overlap a rotation. Empty/unresolvable pins fail CLOSED.
        {mgmt_peer_pins, [{cert_file, "/etc/yuzu/certs/default-server.pem"}]},

        %% HA WS-4 #4555 — gateway multi-node cluster FORMATION (ADR-2002 §7b),
        %% distinct from `cluster_id` above: this is what to RESOLVE to find
        %% peer addresses, not the logical cluster identifier. Default
        %% `"gateway"` matches the reference Compose service name. Override:
        %% YUZU_GW_SEED_DNS_NAME.
        {cluster_seed_dns_name, <<"gateway">>},

        %% An explicit comma-separated peer address list. When set (non-empty),
        %% REPLACES DNS resolution outright — never merged with it. Override:
        %% YUZU_GW_SEED_NODES (e.g. "10.0.0.1,10.0.0.2").
        {cluster_seed_nodes, []},

        %% Always-on redial loop interval (ms) — fixed, no backoff. `connect_all`
        %% is `false` below, so this loop is what forms AND maintains the mesh.
        %% Override: YUZU_GW_CLUSTER_REDIAL_INTERVAL_MS.
        {cluster_redial_interval_ms, 5000},

        %% Lifetime cap on DISTINCT peer addresses ever atomized — see
        %% config/sys.config's identical setting for the full rationale
        %% (PR #4604 review round 2, atom-table exhaustion).
        {cluster_max_lifetime_addrs, 1024},

        %% ── gRPC listeners ──────────────────────────────────────────────────
        %% One map per listener, served by the gateway's own gRPC layer over
        %% Cowboy (yuzu_grpc_listener). They are the supervision tree's LAST
        %% children, and every entry is validated before anything is bound.
        %% `tls` present means TLS and certfile, keyfile AND cacertfile are all
        %% required (an incomplete map refuses boot); omit `tls` for plaintext.
        %% Do NOT also set {grpcbox, servers}: a leftover entry refuses boot.
        {grpc_listeners, [
            %% Agent listener (:50051): ONE-WAY (server-authenticated) TLS --
            %% encrypts the hop and authenticates the GATEWAY to agents WITHOUT
            %% requiring a client cert (verify_none + fail_if_no_peer_cert=false).
            %% This closes the plaintext command-fan-out edge while still letting
            %% an UNENROLLED agent bootstrap (it has no client cert until it
            %% completes CSR enrollment). Agent identity is app-layer (the
            %% enrollment token), NOT transport. The address the gateway forwards
            %% as gateway_observed_peer is attribution for the audit log, not
            %% authentication.
            %%
            %% NEVER give this listener an auth_fun: a peer without a certificate
            %% is refused whenever there is one, and the agents that have not
            %% enrolled yet have none -- it would cut agent bootstrap fleet-wide.
            %% The way to client certificates on this edge is configuration, not
            %% code (docs/user-manual/gateway.md, "Moving the agent edge to mutual
            %% TLS"): `verify => verify_peer, fail_if_no_peer_cert => false` asks
            %% for a certificate and serves the agents that have none.
            %%
            %% Agents ping every 60 s, so the idle timeout is 180 s (the 60 s
            %% default would race the ping). 32 acceptors: reconnect storms.
            #{name => agent,
              service_protos => [agent_pb],
              services => #{'yuzu.agent.v1.AgentService' => yuzu_gw_agent_service},
              listen => #{port => 50051, ip => {0,0,0,0}},
              tls => #{certfile   => "/etc/yuzu/certs/default-gateway.pem",
                       keyfile    => "/etc/yuzu/certs/default-gateway.key",
                       cacertfile => "/etc/yuzu/certs/default-ca.pem",
                       verify => verify_none,
                       fail_if_no_peer_cert => false},
              acceptors => 32,
              http2 => #{idle_timeout => 180000, max_concurrent_streams => 32},
              %% Ceilings on the unauthenticated edge. max_connections bounds file
              %% descriptors: every connection holds one and, for old and new
              %% connections overlapping after a proxy idle cut, a fleet of N
              %% agents needs about 1.5-2xN of them. The ceiling is the systemd
              %% unit's LimitNOFILE (65536) less ~5500 of headroom for the
              %% upstream channel (32 sockets), the health and metrics ports, the
              %% mgmt listener, Erlang distribution and files: 60000 connections
              %% hold to a fleet of about 30000 agents. Raise it with
              %% LimitNOFILE (keep ~5500 below it), lower it if LimitNOFILE is
              %% lower. It is NOT protection against a flood: a connection that
              %% has not finished the PROXY header / TLS handshake is closed
              %% after about 1 s / 10 s, but one that has completed them and keeps
              %% sending is held indefinitely (a PING resets Cowboy's idle timer),
              %% so an unauthenticated peer can fill the ceiling; new connections
              %% then wait in the kernel backlog while established agents are
              %% unaffected until they reconnect. Known residual of this port;
              %% limit connections per source at the L4 balancer or firewall (the
              %% peer reconnects after a restart). The ceiling is soft by the acceptor count
              %% less one.
              %% max_message_bytes: 4 MiB, gRPC's default receive limit. NOT
              %% lowered: an agent's installed-software inventory blob may be 3 MiB
              %% by design (sync_source_installed_software.cpp kMaxBlobBytes; real
              %% captures are ~50 KB), so the whole InventoryReport can approach
              %% 4 MiB. Over-limit frames are refused with RESOURCE_EXHAUSTED from
              %% the 5-byte frame header, before the body is buffered.
              limits => #{max_connections => 60000, max_message_bytes => 4194304}
              %% Behind a load balancer or router? Say so and name the proxies you
              %% trust; with no `origin` the agent's address is the TCP peer, and a
              %% client-sent x-forwarded-for / PROXY header is ignored:
              %%   , origin => #{mode => proxy_protocol,   %% F5 iRule, HAProxy send-proxy-v2
              %%                 sources => [{10,0,0,5}, {{10,1,0,0}, 24}]}
              %%   , origin => #{mode => forwarded_for,    %% a router that terminates TLS
              %%                 sources => [{10,0,0,5}],
              %%                 trusted_hops => 0}        %% 0: the last entry, the router's
              %% See docs/user-manual/gateway.md, "Client addresses behind a proxy".
            },

            %% Mgmt listener (:50063): the PRIVILEGED operator/command plane.
            %% STRICT mTLS (#1314, HIGH-2) + SPKI peer pin (#1422). This listener
            %% binds 0.0.0.0, so a one-way or plaintext posture would leave the
            %% command-fan-out plane UNAUTHENTICATED (anyone routing to it could
            %% push commands to the fleet). By OMITTING verify /
            %% fail_if_no_peer_cert below, the layer uses its strict defaults
            %% (verify_peer + fail_if_no_peer_cert=true) so a client MUST present
            %% a CA-issued cert. The auth_fun then pins the peer to the C++
            %% server's KEY (mgmt_peer_pins above): CA membership alone is NOT
            %% authorization -- the same CA signs every agent leaf and the
            %% gateway's own group-readable leaf, so without the pin any
            %% compromised endpoint's cert could command the fleet (the #1314 M-1
            %% residual, closed by #1422). The auth_fun runs before a handler
            %% exists (yuzu_grpc_stream_h) and only on a TLS listener; the
            %% yuzu_gw_app boot guard refuses a non-loopback management_pb
            %% listener without any of this, and refuses it behind a proxy.
            #{name => mgmt,
              service_protos => [management_pb],
              services => #{'yuzu.server.v1.ManagementService' => yuzu_gw_mgmt_service},
              listen => #{port => 50063, ip => {0,0,0,0}},
              tls => #{certfile   => "/etc/yuzu/certs/default-gateway.pem",
                       keyfile    => "/etc/yuzu/certs/default-gateway.key",
                       cacertfile => "/etc/yuzu/certs/default-ca.pem"},
              auth_fun => fun yuzu_gw_authz:check_mgmt_peer/1,
              acceptors => 4,
              %% One connection per server replica, held open. max_connections
              %% bounds file descriptors; it is NOT protection. 256 is far above
              %% any replica count, but ~256 held connections would stop the
              %% server's NEW connections to this gateway; established ones are
              %% unaffected. Before the TLS handshake anyone with layer-4 reach
              %% can hold a slot (10 s handshake timeout); after it, any holder
              %% of a certificate issued by the install CA can (every enrolled
              %% agent has one; the SPKI pin above runs later, per stream).
              %% KNOWN, accepted, not fixed in the gateway: the management port
              %% (:50063) MUST be firewalled so only the server replicas reach
              %% it. Set listen.ip above to the management interface's address
              %% so it is not bound on the agent-facing one, and where you can
              %% multi-home the server so this interface is on a different NIC
              %% from the agent- and database-facing ones. The shipped composes
              %% do not publish it. Detection and recovery: docs/user-manual/
              %% gateway.md, "Connection ceilings and the unauthenticated ports".
              %% (Before this key the listener's ceiling was infinity.)
              %% 4 MiB messages: a command step carries at most 32 parameters of
              %% 64 KiB each (about 2 MiB).
              limits => #{max_connections => 256, max_message_bytes => 4194304},
              %% The server's command client does not ping: 10 minutes idle.
              %% The server sends every command of a fan-out over its ONE
              %% connection to this port (about 2 received frames per call).
              %% Cowboy's own frame ceiling, 10000 per 10 s, closes that
              %% connection with enhance_your_calm and fails every call in
              %% flight; 100000 per 10 s is the management listener's default
              %% (yuzu_grpc_listener:http2_opts/1), set here so it is visible.
              http2 => #{idle_timeout => 600000, max_concurrent_streams => 1024,
                         max_received_frame_rate => {100000, 10000}}}
        ]},

        %% ── Upstream channel: mutual TLS to the C++ server ──────────────────
        %% Read from {yuzu_gw, upstream_client} by yuzu_grpc_client_config:
        %% from_env/0 (NOT from a {grpcbox, client} entry, which the VM never
        %% applies and which refuses boot if left in this file).
        %% `https` selects ssl (the client advertises ALPN h2). verify_peer is
        %% REQUIRED — an ssl client does NOT verify the server otherwise.
        %% certfile/keyfile present the gateway leaf for the server's client-cert
        %% check (the server's gateway-upstream listener requires a client cert
        %% when TLS is on). Paths point at the server-generated default certs in
        %% the shared cert volume; replace with operator certs if you bring your
        %% own. The dialled host MUST match a SAN in the server's cert (OTP
        %% enforces SNI hostname verification under verify_peer). The default
        %% certs carry SANs `localhost`, `IP:127.0.0.1`, `IP:::1`, and the
        %% server's gethostname() — so the "127.0.0.1" below validates against a
        %% default-cert, same-host install. For cross-container dialing use the
        %% server's hostname and set that service's `hostname:` so its SAN matches.
        {upstream_client, #{channels => [
            {default_channel, [{https, "127.0.0.1", 50055, [
                {cacertfile, "/etc/yuzu/certs/default-ca.pem"},
                {certfile,   "/etc/yuzu/certs/default-gateway.pem"},
                {keyfile,    "/etc/yuzu/certs/default-gateway.key"},
                {verify, verify_peer},
                %% Chain depth 2 — margin for one intermediate (M2 subordinate CA);
                %% the M1 default CA signs leaves directly.
                {depth, 2},
                %% TLS 1.2 floor — no 1.0/1.1 (the listeners above are TLS 1.2 only
                %% too). Prevents a stale OTP VM from negotiating a legacy version.
                {versions, ['tlsv1.2']},
                %% Explicit AEAD + PFS cipher whitelist, ECDSA-leaf-aligned (the
                %% gateway/server leaves are EC P-256). Excludes CBC-SHA1 and
                %% non-PFS RSA-kex suites that some OTP default lists still carry.
                {ciphers, ["ECDHE-ECDSA-AES256-GCM-SHA384",
                           "ECDHE-ECDSA-AES128-GCM-SHA256",
                           "ECDHE-ECDSA-CHACHA20-POLY1305"]}
            ]}], #{}}
        ]}}
    ]},

    {kernel, [
        {connect_all, false},
        {net_ticktime, 30},
        %% HA WS-4 #4555: pin a small distribution port range so it can
        %% actually be firewalled — see config/sys.config's identical block
        %% for the full rationale.
        {inet_dist_listen_min, 9100},
        {inet_dist_listen_max, 9105},
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                level => info,
                formatter => {logger_formatter, #{
                    template => [time, " [", level, "] ", pid, " ", msg, "\n"]
                }}
            }}
        ]}
    ]}
].
