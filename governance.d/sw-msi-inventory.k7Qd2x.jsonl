{"schema_version": 1, "run_id": "sw-msi-inventory.k7Qd2x", "source": "governance-agent", "recorded_by": null, "commit_range": "a98627f7c..6a34b7173", "reporter": "unhappy-path", "reviewed_at_sha": "6a34b7173", "recorded_at": "2026-10-18T18:30:00Z", "pass_ordinal": 1, "finding_id": "mp-no-bounded-wait", "severity_native": "MEDIUM", "severity_mapped": "SHOULD", "trigger": "unresolved", "impact": ["I5"], "exposure": ["E5"], "epistemic_status": "speculative", "policy_floor": null, "provenance": "introduced", "file": "agents/plugins/msi_packages/src/msi_packages_plugin.cpp", "line": 160, "summary": "The msi calls run synchronously on the sync thread with no bounded wait, unlike the DISM call. Judged a registry-backed local read with no network or prompt path.", "classification": "absence", "independent_reporters": 2, "disposition": "open"}
