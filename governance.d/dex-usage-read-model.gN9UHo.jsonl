{"schema_version": 1, "run_id": "dex-usage-read-model.gN9UHo", "source": "governance-agent", "reporter_ref": null, "recorded_by": "Doomgoose", "independent_reporters": 1, "adjudicated_by": null, "adjudication_rationale": null, "refuted_by": null, "refuted_by_reporter": null, "caused_by": null, "waiver_rationale": null, "finding_id": "UP-1", "reporter": "unhappy-path", "severity_native": "MEDIUM", "severity_mapped": "SHOULD", "trigger": "an Apps subject longer than 15 bytes with a multi-byte character over byte 15", "impact": ["I5"], "exposure": ["E3"], "epistemic_status": "likely", "policy_floor": null, "provenance": "introduced", "file": "server/core/src/dex_usage_model.hpp", "line": 234, "classification": "truth-contradiction", "classification_rationale": "see summary", "summary": "The 15-byte truncated key is a byte slice; a multi-byte character straddling byte 15 makes it invalid UTF-8, Postgres rejects the whole statement and the whole usage model is unavailable while that name sits in the Apps window. Fixed in the commit 'gate-fix: governance r1' on feat/dex-usage-core. The key is skipped when byte 15 is a UTF-8 continuation byte; pure tests cover 2-byte and 4-byte characters.", "disposition": "fixed", "recorded_at": "2026-11-16T16:10:00Z", "commit_range": "0d631645947b1847cf7b207b3844a2d30b1be19e..a75a4d186", "reviewed_at_sha": "a75a4d186 (merge-base with origin/dev 0d6316459)", "pass_ordinal": 1}
{"schema_version": 1, "run_id": "dex-usage-read-model.gN9UHo", "source": "governance-agent", "reporter_ref": null, "recorded_by": "Doomgoose", "independent_reporters": 1, "adjudicated_by": null, "adjudication_rationale": null, "refuted_by": null, "refuted_by_reporter": null, "caused_by": null, "waiver_rationale": null, "finding_id": "G-F1", "reporter": "security-guardian", "severity_native": "unresolved (gates pending adjudication)", "severity_mapped": "BLOCKING", "trigger": "the default floor of 1 with a later surface at GuaranteedState:Read", "impact": ["I1"], "exposure": ["unresolved"], "epistemic_status": "likely", "policy_floor": null, "provenance": "introduced", "file": "server/core/src/dex_usage_model.hpp", "line": 116, "classification": "truth-contradiction", "classification_rationale": "see summary", "summary": "At the default floor of 1 a one-device cell publishes that device's usage totals (the data GET /forensics/agents/{id}/app-usage gates behind Forensics:Read); the floor was not clamped; the changelog overstated the forensic permission. Exposure unresolved because no caller exists.", "disposition": "open", "recorded_at": "2026-11-16T14:50:00Z", "commit_range": "0d631645947b1847cf7b207b3844a2d30b1be19e..a75a4d186", "reviewed_at_sha": "a75a4d186 (merge-base with origin/dev 0d6316459)", "pass_ordinal": 1}
{"schema_version": 1, "run_id": "dex-usage-read-model.gN9UHo", "finding_id": "G-F1", "recorded_by": "Doomgoose", "recorded_at": "2026-11-16T16:10:00Z", "pass_ordinal": 1, "reviewed_at_sha": "a75a4d186 (merge-base with origin/dev 0d6316459)", "disposition": "deferred-to-issue #8002", "commit_range": "0d631645947b1847cf7b207b3844a2d30b1be19e..a75a4d186", "severity_mapped": "SHOULD", "impact": ["I7"], "exposure": ["E4"], "epistemic_status": "likely", "provenance": "introduced", "trigger": "a later surface serving fleet usage at the default floor of 1 without its own permission or floor", "adjudicated_by": "Architect (Fable 5.2), governance r1 fix round ruling for G-F1; not the author of the change", "adjudication_rationale": "No surface serves the model, so no control fails today; the default equals the existing DEX cohort-floor ruling and the choice of permission or minimum floor for serving is the product owner's, tracked in #8002. Fixed now: the floor is clamped to >= 1 with a test, the changelog no longer promises a permission, and the model's comments say it applies no authorization and that the floor protects one table only.", "summary": "De-escalated from the raise row: the defects in this change (unclamped floor, overstated changelog) are fixed; the remaining design choice (permission or floor for serving) is #8002."}
